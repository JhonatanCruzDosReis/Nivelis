# Copie para .env e preencha. O .env NUNCA vai para o Git (ver .gitignore).

# Gemini — só a extração de PDF usa. Deixe vazio e a API sobe normalmente,
# com /enade/extrair e /enem/extrair respondendo 503.
GEMINI_API_KEY=

# Notícias (GNews). Em produção, configure no painel do Render, não aqui.
GNEWS_API_KEY=

# Credencial do Firebase: o JSON inteiro em uma linha, OU deixe o arquivo
# chave-firebase.json na pasta.
FIREBASE_CREDENTIALS=

# Segredo das rotas de administração: apagar simulado, limpar cache, ver
# métricas e extrair prova em PDF (que gasta cota paga). Invente uma string
# longa e aleatória. SEM ela, essas rotas respondem 503 para todo mundo —
# fechadas, que é o lado seguro de falhar.
ADMIN_SEGREDO=

# Origens que podem chamar a API de dentro de um NAVEGADOR, separadas por
# vírgula. Deixe VAZIA se você só tem o aplicativo: o React Native não manda
# cabeçalho Origin, não passa por CORS, e funciona com isto em branco.
#
#   vazia                      → só localhost (em qualquer porta)
#   https://nivelis.app,...    → essas origens E localhost
#   *                          → qualquer site (válvula de emergência)
#
# Antes o código vinha com "*" fixo, e no nivelis_api.py junto com
# allow_credentials=True — combinação em que o servidor ECOA a origem de
# quem perguntou, liberando qualquer site do mundo.
CORS_ORIGENS=

# ── Produção (Render): deixe assim ──
# Esconde o detalhe do erro na resposta
DESABILITAR_DETALHES_ERRO=true

# ── MODO_DEV: NÃO ative em produção ──
# Liga o login por header X-Dev-User-Id, que faz qualquer pessoa se passar
# por qualquer usuário. O padrão agora é DESLIGADO, então basta não definir.
# Só descomente na sua máquina, para testar pelo Swagger:
# MODO_DEV=true
